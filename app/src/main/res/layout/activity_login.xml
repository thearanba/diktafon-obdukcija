<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dfm_charcoal"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="32dp">

        <ImageView
            android:layout_width="84dp"
            android:layout_height="84dp"
            android:src="@drawable/dfm_logo"
            android:contentDescription="@string/app_name"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Department of Forensic Medicine"
            android:fontFamily="serif"
            android:textColor="@color/dfm_text"
            android:textSize="18sp"
            android:textStyle="bold"
            android:gravity="center" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Medicinski fakultet UNSA"
            android:fontFamily="serif"
            android:textColor="@color/dfm_text_dim"
            android:textSize="12sp"
            android:layout_marginTop="2dp" />

        <View
            android:layout_width="110dp"
            android:layout_height="2dp"
            android:background="@color/dfm_amber"
            android:layout_marginTop="18dp"
            android:layout_marginBottom="26dp" />

        <TextView
            android:id="@+id/tv_login_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/dfm_text_dim"
            android:textSize="14sp"
            android:gravity="center"
            android:layout_marginBottom="22dp" />

        <EditText
            android:id="@+id/et_password"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/login_hint_password"
            android:inputType="textPassword"
            android:textColor="@color/dfm_text"
            android:layout_marginBottom="12dp" />

        <EditText
            android:id="@+id/et_confirm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/login_hint_confirm"
            android:inputType="textPassword"
            android:textColor="@color/dfm_text"
            android:visibility="gone"
            android:layout_marginBottom="12dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_login_main"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/dfm_amber"
            app:strokeColor="@color/dfm_amber"
            app:strokeWidth="1.5dp"
            android:layout_marginTop="8dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_biometric"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/login_btn_biometric"
            android:textColor="@color/dfm_text"
            app:strokeColor="@color/dfm_text_dim"
            app:strokeWidth="1dp"
            android:visibility="gone"
            android:layout_marginTop="10dp" />

        <Button
            android:id="@+id/btn_forgot"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/login_btn_forgot"
            android:textColor="@color/dfm_text_dim"
            android:textSize="13sp"
            android:layout_marginTop="24dp" />

    </LinearLayout>
</ScrollView>
