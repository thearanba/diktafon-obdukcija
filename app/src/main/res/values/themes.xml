<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Diktafon" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <!-- Identitet Katedre (dfm): ugljeno-tamna baza, amber je samo akcenat.
             ActionBar (Postavke) ostaje tamna; amber ide na kontrole (colorSecondary). -->
        <item name="colorPrimary">@color/dfm_surface</item>
        <item name="colorPrimaryVariant">@color/dfm_charcoal</item>
        <item name="colorOnPrimary">@color/dfm_text</item>
        <item name="colorSecondary">@color/dfm_amber</item>
        <item name="colorOnSecondary">@color/dfm_charcoal</item>
        <item name="android:statusBarColor">@color/dfm_charcoal</item>
        <item name="android:windowBackground">@color/dfm_charcoal</item>
        <item name="android:textColorPrimary">@color/dfm_text</item>
        <item name="android:textColorSecondary">@color/dfm_text_dim</item>
        <item name="android:textColorHint">#6F6862</item>
    </style>
</resources>
